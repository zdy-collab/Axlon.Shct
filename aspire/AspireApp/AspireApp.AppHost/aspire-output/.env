# Docker container name (default: axlon-auth)
AUTH_CONTAINER_NAME=

# Container image name for auth
AUTH_IMAGE=auth:latest

# Default container port for auth
AUTH_PORT=8080

# Docker container name (default: axlon-basic)
BASIC_CONTAINER_NAME=

# Container image name for basic
BASIC_IMAGE=basic:latest

# Default container port for basic
BASIC_PORT=8080

# Docker container name (default: axlon-dashboard)
DASHBOARD_CONTAINER_NAME=

# Parameter dashboard-otlp-api-key
DASHBOARD_OTLP_API_KEY=

# Docker container name (default: axlon-data-migration)
DATA_MIGRATION_CONTAINER_NAME=

# Container image name for data-migration
DATA_MIGRATION_IMAGE=data-migration:latest

# Default container port for data-migration
DATA_MIGRATION_PORT=8080

# Docker container name (default: axlon-files)
FILES_CONTAINER_NAME=

# Container image name for files
FILES_IMAGE=files:latest

# Default container port for files
FILES_PORT=8080

# Persistent storage root for the files service
FILES_STORAGE_ROOT=

# Docker container name (default: axlon-gateway)
GATEWAY_CONTAINER_NAME=

# Container image name for gateway
GATEWAY_IMAGE=

# Docker container name (default: axlon-merchant)
MERCHANT_CONTAINER_NAME=

# Container image name for merchant
MERCHANT_IMAGE=merchant:latest

# Default container port for merchant
MERCHANT_PORT=8080

# Docker container name (default: axlon-mysql)
MYSQL_CONTAINER_NAME=

# Parameter mysql-password
MYSQL_PASSWORD=

# Docker container name (default: axlon-order)
ORDER_CONTAINER_NAME=

