ORDER_IMAGE=order:latest

# Default container port for order
ORDER_PORT=8080

# Docker container name (default: axlon-rabbitmq)
RABBITMQ_CONTAINER_NAME=

# Parameter rabbitmq-password
RABBITMQ_PASSWORD=

# Parameter rabbitmq-user
RABBITMQ_USER=

# Docker container name (default: axlon-redis)
REDIS_CONTAINER_NAME=

