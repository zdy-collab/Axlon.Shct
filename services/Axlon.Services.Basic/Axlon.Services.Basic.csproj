<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Axlon.Services.Basic</RootNamespace>
    <Description>
      Axlon.Services.Basic: basic management microservice (User/Role/Permission/Module/Department/UserRole CRUD
      with full RBAC permission validation). Extracted from Axlon.Framework.SampleApi and re-hosted as an
      Aspire-orchestrated service.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Compile Remove="Log\**" />
    <Content Remove="Logs\**" />
    <Content Remove="Log\**" />
    <EmbeddedResource Remove="Logs\**" />
    <EmbeddedResource Remove="Log\**" />
    <None Remove="Logs\**" />
    <None Remove="Log\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Axlon.Framework.Authentication" />
    <PackageReference Include="Axlon.Framework.Data" />
    <PackageReference Include="Axlon.Framework.EventBus" />
    <PackageReference Include="Axlon.Framework.Serilog" />
    <PackageReference Include="Axlon.Framework.Web" />
    <PackageReference Include="Axlon.Framework.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\aspire\AspireApp\AspireApp.ServiceDefaults\AspireApp.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Axlon.Services.Contracts\Axlon.Services.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="OutInput\Input\File\" />
    <Folder Include="wwwroot\logo\" />
    <Folder Include="wwwroot\BannersJpg\" />
  </ItemGroup>

</Project>
