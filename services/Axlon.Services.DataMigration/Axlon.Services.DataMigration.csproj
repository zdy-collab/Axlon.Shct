<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <RootNamespace>Axlon.Services.DataMigration</RootNamespace>
    <Description>One-shot database schema and seed-data migration service for Axlon microservices.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Axlon.Framework.Core" />
    <PackageReference Include="Axlon.Framework.Data" />
    <PackageReference Include="Axlon.Framework.Serilog" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Axlon.Services.Contracts\Axlon.Services.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
